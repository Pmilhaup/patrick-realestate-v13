---
// The single page shell: head, masthead, main, footer — defined once.
// `legacy` keeps the pre-redesign chapter styles available to pages whose
// working content was preserved; fully redesigned pages pass legacy={false}.
import Mast from '../components/Mast.astro';
import Foot from '../components/Foot.astro';

const {
  title, description, path, current = '',
  ogImage = 'https://patrick.realestate/images/patrick-headshot.jpg',
  jsonLd = null,
  legacy = true,
  page = '',            // body class, e.g. "home", "estate"
  hero = false,         // true when the page opens on full-bleed photography
} = Astro.props;
const canonical = 'https://patrick.realestate' + path;
const lds = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#060D1F">
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="canonical" href={canonical}>
<title>{title}</title>
<meta name="description" content={description}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content="website">
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:site_name" content="Patrick Milhaupt — North Shore">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
{lds.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
<script is:inline>document.documentElement.classList.add('js');addEventListener('unhandledrejection',function(e){var r=e.reason;if(r&&r.name==='AbortError'&&/Transition was aborted/.test(r.message||''))e.preventDefault();});  /* a skipped page transition is not an error: the page simply appears */</script>
<link rel="preload" href="/fonts/cormorant-garamond.woff2" as="font" type="font/woff2" crossorigin>
{legacy && <link rel="stylesheet" href="/brand/brand-shared.css">}
{legacy && <link rel="stylesheet" href="/brand/brand-dark.css">}
{legacy && <link rel="stylesheet" href="/brand/chapter.css">}
{legacy && <link rel="stylesheet" href="/brand/brand-core.css">}
{legacy && <link rel="stylesheet" href="/brand/v13-corrections.css">}
<link rel="stylesheet" href="/brand/site.css">
<slot name="head" />
</head>
<body class:list={['site', page && `page-${page}`, hero && 'has-hero', legacy && 'is-legacy']}>
<a class="skip" href="#main">Skip to content</a>
<Mast current={current} />
<main id="main">
<slot />
</main>
<Foot />
<script is:inline>
/* Behaviour loads after the first frame is on screen, so the opening photograph and headline never wait for it. */
(function () {
  var done = false, go = function () { if (done) return; if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', go, { once: true }); return; } done = true; var s = document.createElement('script'); s.src = '/js/site.js'; document.head.appendChild(s); };
  requestAnimationFrame(function () { setTimeout(go, 0); }); setTimeout(go, 1500);
})();
</script>
<slot name="scripts" />
</body>
</html>
