---
// PROPERTIES — an architectural contact sheet.
// Rendered from the generated listings data (tools/sync_listings.py). Do not hand-edit the tiles.
import Chapter from '../layouts/Chapter.astro';
import listings from '../data/listings.json';
import trophy from '../data/trophy.json';
import Viz from '../components/Viz.astro';

const money = (n) => (n ? '$' + Number(n).toLocaleString('en-US') : '');
const { active, under_contract: pending, sold } = listings;
const tier = trophy.tier;
const byPrice = (a, b) => b.price - a.price;
const withCtx = (l) => ({ ...l, ...(trophy.context[l.key] || {}), ytd: l.year === +trophy.context_as_of.slice(0, 4) });
const trophies = sold.filter((s) => s.price >= tier && s.photo).sort(byPrice).map(withCtx);
const gallery = sold.filter((s) => s.photo && s.price < tier).sort(byPrice);
const ledger = sold.filter((s) => !s.photo).sort(byPrice);
const current = [...active, ...pending];
const SIDE = { list: 'listing', buyer: 'buyer', both: 'both', referral: 'buyer' };
const record = sold.map(withCtx).map((l) => ({ address: l.address, town: l.town, year: l.year, price: l.price, side: SIDE[l.side] || 'listing', side_label: l.side_label, href: l.href || '', rank: l.rank, n: l.n, ytd: l.ytd }));
// Photographs prepared at two sizes: <name>-1400.webp or -1280.webp, with an -800.webp beside it.
const pic = (l) => {
  const src = '/' + l.photo;
  const m = src.match(/^(.*)-(1400|1280)\.webp$/);
  return m ? { src: `${m[1]}-800.webp`, srcset: `${m[1]}-800.webp 800w, ${src} ${m[2]}w` } : { src, srcset: undefined };
};
const vt = (l) => (l.href && l.href.startsWith('/sold/') ? `view-transition-name: sold-${l.href.slice(6)}` : undefined);
const lds = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://patrick.realestate/' },
  { '@type': 'ListItem', position: 2, name: 'Properties', item: 'https://patrick.realestate/properties' } ] };
---
<Chapter
  title="Properties — Patrick Milhaupt · Sotheby's International Realty"
  description="A curated portfolio of extraordinary North Shore residences. Vetted for provenance, architectural distinction, and pricing discipline."
  path="/properties" current="/properties" legacy={false} page="properties"
  jsonLd={lds}
>
  <style slot="head" is:global>
  /* ZenList — a distinct blue brand layered on the practice, kept from the previous page */
  .zen-card { position: relative; margin-top: 32px; padding: clamp(24px, 3vw, 38px); border-radius: 6px; max-width: 760px;
    background: linear-gradient(135deg, rgba(180,210,255,.06), rgba(79,143,255,.04) 50%, rgba(180,210,255,.06)), rgba(6,13,31,.5);
    border: 1px solid rgba(79,143,255,.32); }
  .zen-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, #4f8fff, transparent); }
  .zen-wordmark { font: 500 16px/1 var(--mono); letter-spacing: .04em; color: #6FA5FF; }
  .zen-wordmark .zen-tld { font-weight: 400; color: rgba(111,165,255,.75); }
  .zen-tagline { font: 500 10px/1.5 var(--mono); letter-spacing: .2em; text-transform: uppercase; color: rgba(180,210,255,.7); margin: 8px 0 20px; }
  .zen-card .h3 { color: #E8EFFF; margin-bottom: 10px; }
  .zen-card p.zen-body { color: rgba(214,226,246,.94); margin: 0 0 22px; max-width: 58ch; }
  .zen-btn { display: inline-flex; align-items: center; min-height: 50px; padding: 14px 24px; border-radius: 2px; text-decoration: none;
    font: 600 12.5px/1.1 var(--sans); letter-spacing: .1em; text-transform: uppercase; color: #06080f; background: #6FA5FF; border: 1px solid #6FA5FF; }
  .zen-btn:hover { background: #9CC1FF; border-color: #9CC1FF; }
  .zen-foot { margin: 20px 0 0; padding-top: 14px; border-top: 1px solid rgba(79,143,255,.2); font: 500 10px/1.5 var(--mono); letter-spacing: .16em; text-transform: uppercase; color: rgba(180,210,255,.6); }
  </style>

  <section class="op has-amb" aria-labelledby="props-title">
    <div class="amb" data-amb>
      <picture>
        <source type="image/webp" srcset="/media/film/collection-1280.webp">
        <img src="/media/film/collection-1280.jpg" width="1280" height="720" fetchpriority="high" decoding="async" alt="">
      </picture>
      <video muted playsinline loop preload="none" aria-hidden="true" tabindex="-1" disablepictureinpicture data-src="/media/film/collection-720.mp4"></video>
      <button class="motion-ctl amb-ctl" type="button" data-state="playing" hidden><i aria-hidden="true"></i><span class="t">Pause motion</span></button>
    </div>
    <div class="wrap">
      <div class="op-head">
        <p class="label">Portfolio &middot; North Shore</p>
        <h1 class="display" id="props-title">A <em>collection</em>, carried with restraint.</h1>
        <p class="lede">Current representations, closed sales, and the off-market channel. Every home researched, photographed, and written about the same way.</p>
        <div class="actions">
          <a class="link-arrow" href="#trophy">Trophy sales</a>
          <a class="link-arrow" href="#sold">The sold record</a>
          <a class="link-arrow" href="#off-market">Off-market access</a>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0" aria-label="Listings">
    <div class="wrap">

      <div class="sheet-head" id="current">
        <h2 class="h3">Current</h2>
        <p class="label label--quiet">Represented now</p>
      </div>
      <div class={`sheet ${current.length === 2 ? 'sheet--two' : ''}`}>
        {current.map((l, i) => {
          const estate = l.href === '/listings/999-lake-road';
          const Tag = l.href ? 'a' : 'figure';
          return (
            <Tag class="tile tile--half" href={l.href} tabindex={l.href ? undefined : '0'} aria-label={l.href ? undefined : `${l.address}, ${l.town}. ${l.status}. ${money(l.price)}`}>
              {estate
                ? <img src="/media/999/front-1280.webp" srcset="/media/999/front-800.webp 800w, /media/999/front-1280.webp 1280w, /media/999/front-1920.webp 1920w" sizes="(max-width: 899px) 100vw, 45vw"
                    width="1920" height="1080" decoding="async" fetchpriority={i === 0 ? 'high' : undefined} style="view-transition-name: estate-front; object-position: 50% 42%"
                    alt={`The entrance front of ${l.address}, ${l.town}`}>
                : <img {...pic(l)} sizes="(max-width: 899px) 100vw, 45vw" width="1400" height="781" decoding="async" alt={`${l.address}, ${l.town}`}>}
              <span class="tile-status" data-s={l.status === 'Active' ? 'active' : undefined}>{l.status}</span>
              <span class="tile-info">
                <span class="a">{l.address}</span>
                <span class="m">{l.town} &middot; <b>{money(l.price)}</b>{l.specs ? ` · ${l.specs}` : ''}</span>
                {l.blurb && <span class="m">{l.blurb}</span>}
              </span>
            </Tag>
          );
        })}
      </div>

      <div class="sheet-head" id="trophy">
        <h2 class="h3">Trophy sales</h2>
        <p class="label label--quiet">Closed at {money(tier)} and above</p>
      </div>
      <div class="sheet sheet--trophy">
        {trophies.map((l) => {
          const Tag = l.href ? 'a' : 'figure';
          const Info = l.href ? 'span' : 'figcaption';
          return (
            <Tag class="tile" href={l.href} tabindex={l.href ? undefined : '0'} aria-label={l.href ? undefined : `${l.address}, ${l.town}. Closed ${l.year}. ${money(l.price)}. ${l.side_label}.`}>
              <img {...pic(l)} sizes="(max-width: 560px) 100vw, (max-width: 899px) 50vw, 30vw" width="800" height="600" loading="lazy" decoding="async" style={vt(l)} alt={`${l.address}, ${l.town}`}>
              <span class="tile-status">Closed {l.year}</span>
              <Info class="tile-info">
                <span class="a">{l.address}</span>
                <span class="m">{l.town} &middot; <b>{money(l.price)}</b></span>
                <span class="m">{l.side_label}{l.rank ? ` · No. ${l.rank} of ${l.n} in ${l.town}${l.ytd ? ' to date' : ''}` : ''}{l.href ? ' · Read the sale' : ''}</span>
              </Info>
            </Tag>
          );
        })}
      </div>

      <div class="sheet-head">
        <h2 class="h3">The record</h2>
        <p class="label label--quiet">Every sale of $1,000,000 and above</p>
      </div>
      <Viz kind="record" tier={tier} data={record} height={440} label="Closed sales of one million dollars and above, by year and price" />

      <div class="sheet-head" id="sold">
        <h2 class="h3">Sold</h2>
        <p class="label label--quiet">$1,000,000 to {money(tier)}</p>
      </div>
      <div class="sheet sheet--reveal">
        {gallery.map((l) => {
          const Tag = l.href ? 'a' : 'figure';
          const Info = l.href ? 'span' : 'figcaption';
          return (
            <Tag class="tile" href={l.href} tabindex={l.href ? undefined : '0'} aria-label={l.href ? undefined : `${l.address}, ${l.town}. Closed ${l.year}. ${money(l.price)}. ${l.side_label}.`}>
              <img {...pic(l)} sizes="(max-width: 560px) 100vw, (max-width: 899px) 50vw, 30vw" width="800" height="600" loading="lazy" decoding="async" alt={`${l.address}, ${l.town}`}>
              <span class="tile-status">Closed {l.year}</span>
              <Info class="tile-info">
                <span class="a">{l.address}</span>
                <span class="m">{l.town} &middot; <b>{money(l.price)}</b></span>
                <span class="m">{l.side_label}{l.href ? ' · View the home' : ''}</span>
              </Info>
            </Tag>
          );
        })}
      </div>

      {ledger.length > 0 && (
        <Fragment>
          <div class="sheet-head">
            <h2 class="h3">Also closed</h2>
            <p class="label label--quiet">Without photography on file</p>
          </div>
          <ul class="ledger-rows">
            {ledger.map((l) => (
              <li>
                <span class="la">{l.address}<i> &middot; {l.town}</i></span>
                <span class="ls">{l.side_label} &middot; {l.year}</span>
                <span class="lp">{money(l.price)}</span>
              </li>
            ))}
          </ul>
        </Fragment>
      )}
    </div>
  </section>

  <section class="sec sec--surface" id="off-market" aria-labelledby="om-title">
    <div class="wrap">
      <div class="sec-head">
        <p class="label">Off-market &middot; by introduction</p>
        <h2 class="h2" id="om-title">The market you can&rsquo;t see.</h2>
        <p class="lede">A quiet, curated pre-MLS pipeline measured in days, not weeks. Access is by introduction: activate your private search through the ZenList network or request a personal invitation.</p>
      </div>
      <div class="zen-card">
        <div class="zen-wordmark">zenlist<span class="zen-tld">.realestate</span></div>
        <div class="zen-tagline">Private Listing Network &middot; Powered by ZenList</div>
        <h3 class="h3">Access by introduction.</h3>
        <p class="zen-body">ZenList&rsquo;s pre-MLS feed gives qualified buyers access to homes weeks before they reach public listing sites: quiet sellers, off-market introductions, soft-launch pricing. Activation is complimentary for active clients.</p>
        <div class="actions">
          <a class="zen-btn" href="https://zenlist.realestate" target="_blank" rel="noopener">Activate ZenList access</a>
          <a class="btn-line" href="/contact">Request introduction</a>
        </div>
        <p class="zen-foot">A layer on top of the practice &middot; not a replacement for it</p>
      </div>
    </div>
  </section>
</Chapter>
