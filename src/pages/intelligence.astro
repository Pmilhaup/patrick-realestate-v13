---
// INTELLIGENCE — one page, three acts (08_TECHNICAL_ARCHITECTURE §4).
// Approved and promoted to the canonical "/intelligence" route 2026-07-25.
// The previous eleven-KPI chapter page is preserved at src/_superseded-2026-07/.
// Act 1: The Map · Act 2: One chart, selectable datasets, 5 consumer KPIs
// Act 3: Momentum verdict + briefing signup
import Chapter from '../layouts/Chapter.astro';
const lds = [{
  "@context":"https://schema.org","@type":"Dataset",
  "name":"North Shore Market Intelligence",
  "description":"Daily-reconciled MLS market metrics for the seven North Shore villages: median sale price, days on market, sale-to-list, absorption, months of supply and contract velocity.",
  "url":"https://patrick.realestate/intelligence",
  "creator":{"@type":"RealEstateAgent","name":"Patrick Milhaupt","@id":"https://patrick.realestate/#agent"},
  "spatialCoverage":"North Shore, Chicago, IL",
  "isAccessibleForFree":true
}];
---
<Chapter
  title="Intelligence — Patrick Milhaupt"
  description="The North Shore market in one page: live map, one chart with every dataset, and a momentum read per village — reconciled daily from the MLS."
  path="/intelligence" current="/intelligence" palette="0.55"
  jsonLd={lds[0]}
  rail={[{id:'act-1',num:'01',label:'Map'},{id:'act-2',num:'02',label:'Chart'},{id:'act-3',num:'03',label:'Verdict'}]}
  stdScripts={true} orchestrator={true}
>
  <link slot="head" rel="stylesheet" href="/brand/brand-core.css">
  <script slot="head" src="https://cdn.jsdelivr.net/npm/echarts@5.5.1/dist/echarts.min.js" defer is:inline></script>
  <script slot="head" src="https://cdn.jsdelivr.net/npm/lightweight-charts@4.2.0/dist/lightweight-charts.standalone.production.js" defer is:inline></script>
  <script slot="head" src="/js/intel-data.js" defer is:inline></script>
  <style slot="head" is:global>
  .act { padding: 110px 0 70px; }
  .act .inner { width: min(1120px, calc(100% - 48px)); margin: 0 auto; }
  .act-eyebrow { font-family: var(--font-mono); font-size: 11px; letter-spacing: .25em;
    text-transform: uppercase; color: var(--gold-400); display: block; margin-bottom: 18px; }
  .act h1, .act h2 { font-family: var(--font-serif); font-weight: 300; color: var(--ink-1);
    letter-spacing: -0.02em; line-height: 1.1; margin: 0 0 16px; font-size: clamp(32px, 4.4vw, 56px); }
  .act h1 em, .act h2 em { font-style: italic; color: var(--gold-200); }
  .act .lede { font-family: var(--font-sans); font-weight: 300; font-size: 16px; line-height: 1.65;
    color: var(--ink-3); max-width: 620px; }
  .pill-live { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono);
    font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-3);
    border: 1px solid rgba(194,162,101,.25); border-radius: 999px; padding: 8px 16px; margin-top: 18px; }
  .pill-live .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--gold-300); }
  .pill-live.stale .dot { background: #D97706; }
  .pill-live.err .dot { background: #BE1E44; }

  .map-frame { margin-top: 34px; border: 1px solid rgba(194,162,101,.25); border-radius: 12px; overflow: hidden; }
  .map-frame iframe { display: block; width: 100%; height: min(72vh, 640px); border: 0; }
  .act-note { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .08em;
    color: var(--ink-4); margin-top: 12px; }

  .controls { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 30px 0 16px; }
  .chipset { display: flex; flex-wrap: wrap; gap: 7px; }
  .chip { font-family: var(--font-sans); font-size: 12px; font-weight: 500; letter-spacing: .04em;
    padding: 8px 14px; border-radius: 999px; border: 1px solid rgba(194,162,101,.28);
    background: transparent; color: var(--ink-2); cursor: pointer;
    transition: color var(--t-fast) var(--ease-inout), border-color var(--t-fast) var(--ease-inout), background var(--t-fast) var(--ease-inout); }
  .chip:hover { color: var(--gold-200); border-color: var(--gold-400); }
  .chip.on { background: rgba(194,162,101,.14); border-color: var(--gold-300); color: var(--gold-100); }
  .chip:focus-visible { outline: 1.5px solid var(--gold-400); outline-offset: 2px; }
  .seg { display: inline-flex; padding: 4px; gap: 4px; background: var(--navy-1);
    border: 1px solid rgba(255,255,255,.06); border-radius: 999px; }
  .seg button { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase;
    padding: 7px 13px; border-radius: 999px; background: transparent; color: var(--ink-4); border: 0; cursor: pointer; }
  .seg button.on { background: rgba(194,162,101,.12); color: var(--gold-200);
    box-shadow: inset 0 0 0 1px rgba(194,162,101,.45); }

  .chart-shell { background: var(--navy-1); border: 1px solid rgba(194,162,101,.2);
    border-radius: 12px; padding: 10px; min-height: 480px; }
  #bigchart { width: 100%; height: 480px; }
  #momChart { width: 100%; height: 300px; }
  .chart-shell.momentum { min-height: 0; margin-top: 18px; padding: 14px 6px 4px; }
  .cmp { margin-left: auto; }
  #lwchart { width: 100%; height: 340px; }
  .chart-shell.terminal { min-height: 0; padding-bottom: 10px; }
  .lw-head { display:flex; justify-content:space-between; align-items:baseline; gap:14px; flex-wrap:wrap; padding: 4px 6px 12px; }
  .lw-title { font-family: var(--font-serif, "Cormorant Garamond", serif); font-size: 20px; color: #fff; }
  .lw-sub { font-family: var(--font-mono, "JetBrains Mono", monospace); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: #6C7A96; }
  .foot-note2 { font-family: var(--font-mono); font-size: 10.5px; color: var(--ink-4);
    letter-spacing: .04em; line-height: 1.7; margin-top: 12px; max-width: 720px; }

  .kpi-strip { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; margin-top: 18px; }
  .kcard { background: var(--navy-1); border: 1px solid rgba(194,162,101,.18); border-radius: 10px;
    padding: 16px 18px; cursor: pointer; text-align: left;
    transition: border-color var(--t-fast) var(--ease-inout); }
  .kcard:hover, .kcard.on { border-color: var(--gold-400); }
  .kcard .l { font-family: var(--font-mono); font-size: 10px; letter-spacing: .16em;
    text-transform: uppercase; color: var(--ink-4); display: block; }
  .kcard .v { font-family: var(--font-mono); font-weight: 500; font-size: 24px; color: var(--ink-1);
    display: block; margin-top: 8px; font-variant-numeric: tabular-nums; }
  .kcard .dl { font-family: var(--font-sans); font-size: 11px; margin-top: 6px; display: block; color: var(--ink-4); }
  .kcard .dl.up { color: #6FBF9A; } .kcard .dl.down { color: #D98686; }
  details.adv { margin-top: 16px; }
  details.adv summary { font-family: var(--font-mono); font-size: 11px; letter-spacing: .16em;
    text-transform: uppercase; color: var(--ink-4); cursor: pointer; list-style: none; }
  details.adv summary:hover { color: var(--gold-300); }
  details.adv summary::before { content: "+ "; color: var(--gold-400); }
  details.adv[open] summary::before { content: "− "; }
  details.adv .chipset { margin-top: 12px; }

  .mom-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 14px; margin-top: 30px; }
  .mcard { background: var(--navy-1); border: 1px solid rgba(194,162,101,.18); border-radius: 12px; padding: 20px 22px; }
  .mcard .head { display: flex; justify-content: space-between; font-family: var(--font-mono);
    font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-4); }
  .mcard .head .tier { color: var(--gold-300); }
  .mcard .vn { font-family: var(--font-serif); font-size: 21px; color: var(--ink-1); margin-top: 8px; }
  .mcard .score { font-family: var(--font-mono); font-size: 26px; font-weight: 500; color: var(--gold-200); margin-top: 6px; }
  .mcard .narr { font-family: var(--font-sans); font-size: 12.5px; line-height: 1.55; color: var(--ink-3); margin-top: 10px; }

  .signup { margin-top: 60px; background: var(--navy-1); border: 1px solid rgba(194,162,101,.25);
    border-radius: 12px; padding: 30px; display: flex; flex-wrap: wrap; gap: 18px; align-items: center; justify-content: space-between; }
  .signup .t { font-family: var(--font-serif); font-size: 22px; color: var(--ink-1); }
  .signup .s { font-family: var(--font-sans); font-size: 13px; color: var(--ink-3); margin-top: 4px; }
  .signup form { display: flex; gap: 10px; flex-wrap: wrap; }
  .signup input { font-family: var(--font-sans); font-size: 14px; padding: 12px 16px; min-width: 240px;
    background: var(--navy-0); border: 1px solid rgba(255,255,255,.1); border-radius: 6px; color: var(--ink-1); }
  .signup input:focus { outline: none; border-color: var(--gold-400); }
  .signup button { font-family: var(--font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase;
    background: var(--gold-400); color: #10182B; font-weight: 600; border: 0; border-radius: 6px;
    padding: 12px 22px; cursor: pointer; }
  .signup button:hover { background: var(--gold-300); }
  .signup .st { font-family: var(--font-mono); font-size: 10.5px; color: var(--ink-4); width: 100%; }
  </style>

  <!-- ═══ ACT 1 · THE MAP — orientation first ═══ -->
  <section class="chapter act" id="act-1" data-chapter="0" data-palette="0.40">
    <div class="inner">
      <span class="act-eyebrow fade-up">Intelligence &middot; Act I</span>
      <h1 class="headline" data-headline="">Where is the market <em>moving</em>?</h1>
      <p class="lede fade-up">Every closed sale on the corridor, plotted live. Bubble size is transaction activity; color is momentum.</p>
      <div class="pill-live fade-up" id="livePill"><span class="dot"></span><span id="liveTxt">Connecting&hellip;</span></div>
      <div class="map-frame fade-up">
        <iframe src="/market-map" title="Live North Shore market map" loading="lazy"></iframe>
      </div>
      <p class="act-note fade-up">Updated daily from MLS &amp; Infosparks &middot; open full-screen at <a href="/market-map" style="color:var(--gold-300);">/market-map</a></p>
    </div>
  </section>

  <!-- ═══ ACT 2 · ONE CHART, EVERY DATASET ═══ -->
  <section class="chapter act" id="act-2" data-chapter="1" data-palette="0.60">
    <div class="inner">
      <span class="act-eyebrow fade-up">Intelligence &middot; Act II</span>
      <h2 class="headline" data-headline="">One chart. Every <em>signal</em>.</h2>
      <p class="lede fade-up">Pick the dataset, the village, and the window. Reconciled each morning against a five-year Infosparks baseline.</p>

      <div class="controls fade-up">
        <div class="chipset" id="villageChips" role="tablist" aria-label="Village"></div>
        <div class="seg" id="scopeSeg">
          <button data-scope="all" class="on">All SF</button>
          <button data-scope="luxury">$2M+ Luxury</button>
        </div>
        <div class="seg" id="rangeSeg">
          <button data-range="1">1Y</button>
          <button data-range="3" class="on">3Y</button>
          <button data-range="5">5Y</button>
          <button data-range="99">All</button>
      </div>
        <button class="chip cmp" id="cmpToggle" aria-pressed="false">Compare all villages</button>
      </div>

      <div class="kpi-strip fade-up" id="kpiStrip"></div>

      <details class="adv fade-up">
        <summary>Advanced datasets</summary>
        <div class="chipset" id="advChips"></div>
      </details>

      <div class="chart-shell terminal fade-up" style="margin-top:18px;">
        <div class="lw-head"><span class="lw-title" id="lwTitle">Median Price · North Shore</span><span class="lw-sub">30-day rolling · weekly samples · crosshair, pan &amp; zoom</span></div>
        <div id="lwchart"></div>
      </div>
      <div class="chart-shell fade-up" style="margin-top:18px;">
        <div id="bigchart"></div>
      </div>
      <p class="foot-note2 fade-up">
        &ldquo;North Shore&rdquo; medians are medians of the village medians &middot; $/SqFt and ratio metrics reflect the subset of
        comps reporting the underlying fields &middot; Luxury scope begins where its data begins &mdash; ranges without data are not shown.
      </p>
    </div>
  </section>

  <!-- ═══ ACT 3 · THE VERDICT ═══ -->
  <section class="chapter act" id="act-3" data-chapter="2" data-palette="0.80">
    <div class="inner">
      <span class="act-eyebrow fade-up">Intelligence &middot; Act III</span>
      <h2 class="headline" data-headline="">Is it your <em>window</em>?</h2>
      <p class="lede fade-up">A momentum read per village — supply, velocity, and pricing pressure resolved into one signal.</p>
      <div class="controls fade-up" style="margin-top:22px;"><div class="chipset" id="tierChips" role="tablist" aria-label="Momentum tier"></div></div>
      <div class="chart-shell momentum fade-up"><div id="momChart"></div></div>
      <div class="mom-grid fade-up" id="momGrid"></div>

      <div class="signup fade-up">
        <div>
          <div class="t">Get this briefing monthly.</div>
          <div class="s">One email when the numbers move. No listings spam, ever.</div>
        </div>
        <form id="briefForm" novalidate>
          <input type="email" id="briefEmail" placeholder="your@email.com" required maxlength="200" aria-label="Email for monthly briefing">
          <button type="submit">Subscribe</button>
          <span class="st" id="briefStatus"></span>
        </form>
      </div>
    </div>
  </section>

  <script slot="scripts" is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    /* intel-data.js provides: SUPA, VILLAGES, KPIS, FMT, supaFetch, supaRpc,
       loadVillageSeries, aggregateNorthShore, indexByMetric, rollingMean,
       linearInterpolate, latestOf, findNearDaysAgo, pctChange */
    if (typeof loadVillageSeries === 'undefined') return;

    var CONSUMER = ['median_price','units_sold','dom','sp_lp','months_supply'];
    var S = { village: 'North Shore', scope: 'all', range: 3,
              metric: 'median_price', data: null };
    var CACHE = {};

    /* ── controls ── */
    var vc = document.getElementById('villageChips');
    VILLAGES.forEach(function (v) {
      var b = document.createElement('button');
      b.className = 'chip' + (v === S.village ? ' on' : '');
      b.textContent = v; b.setAttribute('role','tab');
      b.addEventListener('click', function () { S.village = v; refresh(); });
      vc.appendChild(b);
    });
    document.querySelectorAll('#scopeSeg button').forEach(function (b) {
      b.addEventListener('click', function () { S.scope = b.dataset.scope; S.cmpData = null; if (S.compare) { S.compare = false; var c = document.getElementById('cmpToggle'); c.classList.remove('on'); c.setAttribute('aria-pressed','false'); } refresh(); });
    });
    document.querySelectorAll('#rangeSeg button').forEach(function (b) {
      b.addEventListener('click', function () {
        S.range = Number(b.dataset.range);
        document.querySelectorAll('#rangeSeg button').forEach(function (x) { x.classList.toggle('on', x === b); });
        draw();
      });
    });
    var adv = document.getElementById('advChips');
    KPIS.filter(function (k) { return CONSUMER.indexOf(k.id) === -1; }).forEach(function (k) {
      var b = document.createElement('button');
      b.className = 'chip'; b.textContent = k.label;
      b.addEventListener('click', function () { S.metric = k.metric; syncChips(); draw(); });
      adv.appendChild(b);
    });

    function kpiById(id) { return KPIS.filter(function (k) { return k.id === id; })[0]; }
    function kpiByMetric(m) { return KPIS.filter(function (k) { return k.metric === m; })[0]; }

    function setPill(kind, msg) {
      var p = document.getElementById('livePill');
      p.className = 'pill-live' + (kind ? ' ' + kind : '');
      document.getElementById('liveTxt').textContent = msg;
    }

    /* ── data ── */
    function load(village, scope) {
      var key = village + '|' + scope;
      if (CACHE[key]) return Promise.resolve(CACHE[key]);
      return loadVillageSeries(village, scope).then(function (rows) {
        var data = (village === 'North Shore')
          ? (function () {
              var agg = aggregateNorthShore(rows, scope), d = {};
              agg.forEach(function (r) { (d[r.metric] = d[r.metric] || []).push({ d: r.d, source: r.source, value: r.value }); });
              Object.keys(d).forEach(function (m) { d[m].sort(function (a, b) { return a.d.localeCompare(b.d); }); });
              return d;
            })()
          : indexByMetric(rows, scope);
        CACHE[key] = data;
        return data;
      });
    }

    function refresh() {
      document.querySelectorAll('#villageChips .chip').forEach(function (c) { c.classList.toggle('on', c.textContent === S.village); });
      document.querySelectorAll('#scopeSeg button').forEach(function (b) { b.classList.toggle('on', b.dataset.scope === S.scope); });
      load(S.village, S.scope).then(function (data) {
        S.data = data;
        var newest = null;
        Object.keys(data).forEach(function (m) {
          var a = data[m]; if (a.length && (!newest || a[a.length - 1].d > newest)) newest = a[a.length - 1].d;
        });
        if (newest) {
          var age = Math.floor((Date.now() - new Date(newest + 'T12:00:00').getTime()) / 86400000);
          setPill(age <= 2 ? '' : 'stale',
            'Data as of ' + new Date(newest + 'T12:00:00').toLocaleDateString(undefined, { month: 'short', day: 'numeric' }) +
            (age > 2 ? ' · reconciled ' + age + ' days ago' : ' · live'));
        } else { setPill('err', 'Data unavailable'); }
        strip(); draw();
      }).catch(function () { setPill('err', 'Data unavailable'); });
    }

    /* ── KPI strip ── */
    function strip() {
      var el = document.getElementById('kpiStrip'); el.innerHTML = '';
      CONSUMER.forEach(function (id) {
        var k = kpiById(id); if (!k) return;
        var series = S.data[k.metric] || [];
        /* Flow metrics (event counts) are summed across a trailing 30-day
           window; level metrics use the trailing-window median. Both avoid
           reading an incomplete newest snapshot as a finished period — the
           bug that published "Median Price −89.0%" and "Closed Sales 2". */
        var isFlow = !!FLOW_METRICS[k.metric];
        var last  = isFlow ? windowSum(series, 30, 0)  : robustLatest(series, 7);
        var prior = isFlow ? windowSum(series, 30, 30) : robustNearDaysAgo(series, 30, 7);
        var delta = prior && last ? pctChange(last.value, prior.value) : null;
        var card = document.createElement('button');
        card.className = 'kcard' + (S.metric === k.metric ? ' on' : '');
        var cls = 'dl', txt = '—';
        /* A >60% month-over-month move in any of these is a data artefact,
           not a market event. Suppress rather than publish it. */
        if (delta != null && !isNaN(delta) && Math.abs(delta) <= 60) {
          var fav = k.invert ? delta < 0 : delta > 0;
          cls += Math.abs(delta) < 0.5 ? '' : (fav ? ' up' : ' down');
          txt = (delta > 0 ? '+' : '') + delta.toFixed(1) + '% vs 30d';
        }
        var lbl = isFlow ? k.label + ' · 30d' : k.label;
        card.innerHTML = '<span class="l">' + lbl + '</span>' +
          '<span class="v">' + (last ? (FMT[k.fmt] || FMT.int)(last.value) : '—') + '</span>' +
          '<span class="' + cls + '">' + txt + '</span>';
        card.addEventListener('click', function () { S.metric = k.metric; syncChips(); draw(); });
        el.appendChild(card);
      });
    }
    function syncChips() {
      document.querySelectorAll('#kpiStrip .kcard').forEach(function (c, i) {
        var k = kpiById(CONSUMER[i]); c.classList.toggle('on', k && k.metric === S.metric);
      });
    }

    /* Rolling MEDIAN over a trailing day-window — a single sparse-day spike
       cannot move it, unlike a rolling mean. Same contract as rollingMean. */
    function rollingMedian(series, days) {
      var out = [], ms = days * 86400000, q = [];
      for (var i = 0; i < series.length; i++) {
        var t = new Date(series[i].d + 'T00:00:00Z').getTime();
        q.push({ t: t, v: series[i].value });
        while (q.length && t - q[0].t > ms) q.shift();
        var a = q.map(function (x) { return x.v; }).sort(function (x, y) { return x - y; });
        var m = a.length % 2 ? a[(a.length - 1) / 2] : (a[a.length / 2 - 1] + a[a.length / 2]) / 2;
        out.push({ d: series[i].d, value: m });
      }
      return out;
    }

    /* ── the one chart · Apache ECharts ── */
    var EC = null, VPAL = ['#EAD9AE','#8CA3C6','#5FB3A8','#C98A7A','#9A8CF5','#D9BE85','#6C8CB8'];
    function cutFor() {
      var r = Number(S.range); if (!isFinite(r) || r >= 99) return '1900-01-01';
      var c = new Date(); var y = c.getFullYear() - r, m = c.getMonth() + 1, d = c.getDate();
      return y + '-' + (m < 10 ? '0' : '') + m + '-' + (d < 10 ? '0' : '') + d;
    }
    function seriesFor(data, k) {
      var raw = data[k.metric] || [], cut = cutFor();
      var series = S.range >= 99 ? raw : raw.filter(function (p) { return p.d >= cut; });
      var dense = linearInterpolate(series.filter(function (p) { return p && p.d && p.value != null && !isNaN(p.value); })).filter(function (p) { return p.value != null; });
      /* Rolling MEDIAN resists sparse-day spikes (one $9M closing must not move a
         30-day read); a light 7-day mean afterwards gives the line its curve. */
      return { raw: raw, r30: rollingMean(rollingMedian(dense, 30), 7), r90: rollingMean(rollingMedian(dense, 90), 7) };
    }
    function rollingMedian(series, days) {
      var out = [], ms = days * 86400000, q = [];
      for (var i = 0; i < series.length; i++) {
        var t = new Date(series[i].d + 'T00:00:00Z').getTime();
        q.push({ t: t, v: series[i].value });
        while (q.length && t - q[0].t > ms) q.shift();
        var a = q.map(function (x) { return x.v; }).sort(function (x, y) { return x - y; });
        var m = a.length % 2 ? a[(a.length - 1) / 2] : (a[a.length / 2 - 1] + a[a.length / 2]) / 2;
        out.push({ d: series[i].d, value: m });
      }
      return out;
    }
    function pts(a) { return a.map(function (p) { return [p.d, Math.round(p.value * 100) / 100]; }); }
    function draw() {
      if (typeof echarts === 'undefined' || !S.data) return;
      var k = kpiByMetric(S.metric) || kpiById('median_price');
      var fmt = FMT[k.fmt] || FMT.int;
      var el = document.getElementById('bigchart');
      if (!EC) { EC = echarts.init(el, null, { renderer: 'canvas' }); window.addEventListener('resize', function () { EC.resize(); }); }
      var series = [], sub;
      if (S.compare && S.cmpData) {
        VILLAGES.filter(function (v) { return v !== 'North Shore'; }).forEach(function (v, i) {
          var d = S.cmpData[v]; if (!d) return;
          var sv; try { sv = seriesFor(d, k).r30; } catch (e) { return; } if (!sv.length) return;
          series.push({ name: v, type: 'line', smooth: 0.35, showSymbol: false, sampling: 'lttb',
            lineStyle: { width: 1.9, color: VPAL[i] }, itemStyle: { color: VPAL[i] }, emphasis: { focus: 'series', lineStyle: { width: 3 } },
            data: pts(sv) });
        });
        sub = 'Seven villages · 30-day rolling · ' + (S.scope === 'luxury' ? '$2M+ Luxury' : 'All single-family');
      } else {
        var sf = seriesFor(S.data, k);
        series = [
          { name: '90-day trend', type: 'line', smooth: 0.4, showSymbol: false, sampling: 'lttb', z: 1,
            lineStyle: { width: 1.3, color: 'rgba(139,139,250,0.75)', type: [6, 5] }, itemStyle: { color: '#8B8BFA' }, data: pts(sf.r90) },
          { name: '30-day rolling', type: 'line', smooth: 0.4, showSymbol: false, sampling: 'lttb', z: 2,
            lineStyle: { width: 2.6, color: '#EAD9AE' }, itemStyle: { color: '#EAD9AE' },
            areaStyle: { color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [{ offset: 0, color: 'rgba(194,162,101,0.42)' }, { offset: 1, color: 'rgba(194,162,101,0.0)' }]) },
            endLabel: { show: true, formatter: function (p) { return fmt(p.value[1]); }, color: '#EAD9AE', fontFamily: 'JetBrains Mono', fontSize: 11, offset: [6, 0] },
            data: pts(sf.r30) }
        ];
        sub = S.village + ' · ' + (S.scope === 'luxury' ? '$2M+ Luxury' : 'All single-family');
        drawTerminal(k, sf.raw, sf.r30);
      }
      EC.setOption({
        backgroundColor: 'transparent', animationDuration: 900, animationDurationUpdate: 600, animationEasing: 'cubicOut',
        title: { text: k.label, subtext: sub, left: 'center', top: 6,
          textStyle: { fontFamily: 'Cormorant Garamond, serif', fontSize: 24, fontWeight: 500, color: '#FFFFFF' },
          subtextStyle: { fontFamily: 'JetBrains Mono, monospace', fontSize: 10, color: '#93A0B8' } },
        legend: { top: 58, icon: 'roundRect', itemWidth: 16, itemHeight: 3, textStyle: { color: '#93A0B8', fontFamily: 'Public Sans, sans-serif', fontSize: 12 }, inactiveColor: '#3A4660' },
        grid: { left: 14, right: 86, top: 96, bottom: 86, containLabel: true },
        tooltip: { trigger: 'axis', backgroundColor: 'rgba(7,18,41,0.94)', borderColor: 'rgba(240,214,138,0.30)',
          textStyle: { color: '#FFFFFF', fontFamily: 'JetBrains Mono, monospace', fontSize: 12 },
          axisPointer: { type: 'cross', crossStyle: { color: 'rgba(234,217,174,0.35)' }, label: { backgroundColor: '#122246', fontFamily: 'JetBrains Mono, monospace', fontSize: 10 } },
          valueFormatter: function (v) { return fmt(v); } },
        xAxis: { type: 'time', axisLine: { lineStyle: { color: 'rgba(234,217,174,0.15)' } }, axisTick: { show: false },
          axisLabel: { color: '#6C7A96', fontFamily: 'JetBrains Mono, monospace', fontSize: 10 }, splitLine: { show: false } },
        yAxis: { type: 'value', scale: true, axisLabel: { color: '#6C7A96', fontFamily: 'JetBrains Mono, monospace', fontSize: 10, formatter: function (v) { return fmt(v); } },
          splitLine: { lineStyle: { color: 'rgba(234,217,174,0.06)' } }, axisLine: { show: false } },
        dataZoom: [ { type: 'inside', zoomOnMouseWheel: 'ctrl', moveOnMouseMove: true },
          { type: 'slider', height: 22, bottom: 20, borderColor: 'rgba(234,217,174,0.15)', backgroundColor: 'rgba(255,255,255,0.02)',
            fillerColor: 'rgba(194,162,101,0.12)', handleStyle: { color: '#C2A265', borderColor: '#C2A265' }, moveHandleStyle: { color: '#C2A265' },
            dataBackground: { lineStyle: { color: 'rgba(194,162,101,0.45)' }, areaStyle: { color: 'rgba(194,162,101,0.10)' } },
            selectedDataBackground: { lineStyle: { color: '#EAD9AE' }, areaStyle: { color: 'rgba(234,217,174,0.18)' } },
            textStyle: { color: '#6C7A96', fontFamily: 'JetBrains Mono, monospace', fontSize: 10 } } ],
        series: series
      }, true);
    }
    /* compare toggle — loads the other six villages on demand (cached per scope) */
    document.getElementById('cmpToggle').addEventListener('click', function () {
      var b = this; S.compare = !S.compare; b.classList.toggle('on', S.compare); b.setAttribute('aria-pressed', String(S.compare));
      if (!S.compare) { draw(); return; }
      b.textContent = 'Loading villages…';
      Promise.all(VILLAGES.filter(function (v) { return v !== 'North Shore'; }).map(function (v) { return load(v, S.scope).then(function (d) { return [v, d]; }); }))
        .then(function (pairs) { S.cmpData = {}; pairs.forEach(function (pr) { S.cmpData[pr[0]] = pr[1]; }); b.textContent = 'Compare all villages'; draw(); })
        .catch(function () { b.textContent = 'Compare all villages'; S.compare = false; b.classList.remove('on'); draw(); });
    });

    /* ── terminal chart (TradingView Lightweight Charts) ──
       Monthly medians of the selected dataset, then the robust trailing-7
       current reading as the final point. Calm by construction. */
    var LW = null;
    function drawTerminal(k, raw, series) {
      if (typeof LightweightCharts === 'undefined') return;
      var el = document.getElementById('lwchart'); if (!el) return;
      var fmt = FMT[k.fmt] || FMT.int;
      var buckets = {};
      series.forEach(function (p) { if (p.value == null || isNaN(p.value)) return; var m = p.d.slice(0, 7); (buckets[m] = buckets[m] || []).push(Number(p.value)); });
      var data = Object.keys(buckets).sort().map(function (m) {
        var a = buckets[m].slice().sort(function (x, y) { return x - y; });
        return { time: m + '-01', value: a[Math.floor(a.length / 2)] };
      });
      var cur = robustLatest(raw, 7);
      if (cur && data.length) {
        var lastM = data[data.length - 1].time.slice(0, 7);
        if (cur.d.slice(0, 7) === lastM) data[data.length - 1] = { time: cur.d, value: cur.value };
        else if (cur.d > data[data.length - 1].time) data.push({ time: cur.d, value: cur.value });
      }
      if (!LW) {
        LW = { chart: LightweightCharts.createChart(el, {
          layout: { background: { type: 'solid', color: 'transparent' }, textColor: '#6C7A96', fontFamily: "'JetBrains Mono', monospace", fontSize: 10 },
          grid: { vertLines: { color: 'rgba(234,217,174,0.05)' }, horzLines: { color: 'rgba(234,217,174,0.05)' } },
          rightPriceScale: { borderColor: 'rgba(234,217,174,0.12)' },
          timeScale: { borderColor: 'rgba(234,217,174,0.12)', timeVisible: false },
          crosshair: { mode: 0,
            vertLine: { color: 'rgba(234,217,174,0.35)', width: 1, style: 2, labelBackgroundColor: '#122246' },
            horzLine: { color: 'rgba(234,217,174,0.35)', width: 1, style: 2, labelBackgroundColor: '#122246' } },
          handleScroll: true, handleScale: true, autoSize: true }) };
        LW.series = LW.chart.addAreaSeries({ lineColor: '#C2A265', topColor: 'rgba(194,162,101,0.48)', bottomColor: 'rgba(194,162,101,0.02)', lineWidth: 2.5, lastValueVisible: true, priceLineVisible: false,
          crosshairMarkerBorderColor: '#EAD9AE', crosshairMarkerBackgroundColor: '#C2A265' });
      }
      LW.series.applyOptions({ priceFormat: { type: 'custom', formatter: function (v) { return fmt(v); } } });
      LW.series.setData(data);
      LW.chart.timeScale().fitContent();
      var t = document.getElementById('lwTitle'); if (t) t.textContent = k.label + ' · ' + S.village;
    }

    /* ── momentum · ECharts bar + tier filter + cards ── */
    var MOM = [], TIER = 'ALL', MC = null;
    var TIER_COLOR = { HEATING: '#F0D68A', FIRMING: '#8B8BFA', BALANCED: '#8FA0B8', SOFTENING: '#BE7A8A', COOLING: '#BE7A8A' };
    function tierOf(m) { return String(m.tier || '').toUpperCase(); }
    function renderMomentum() {
      var g = document.getElementById('momGrid'); g.innerHTML = '';
      var rows = MOM.filter(function (m) { return TIER === 'ALL' || tierOf(m) === TIER; })
                    .sort(function (a, b) { return (b.composite_score || 0) - (a.composite_score || 0); });
      rows.forEach(function (m) {
        var d = document.createElement('div'); d.className = 'mcard';
        d.innerHTML = '<div class="head"><span>Momentum</span><span class="tier" style="color:' + (TIER_COLOR[tierOf(m)] || '#D9BE85') + '">' + (m.tier || '') + '</span></div>' +
          '<div class="vn">' + m.village + '</div>' +
          '<div class="score">' + (m.composite_score != null ? (m.composite_score > 0 ? '+' : '') + Number(m.composite_score).toFixed(1) : '—') + '</div>' +
          '<div class="narr">' + (m.narrative || m.summary || '') + '</div>';
        g.appendChild(d);
      });
      if (typeof echarts === 'undefined') return;
      var el = document.getElementById('momChart');
      if (!MC) { MC = echarts.init(el, null, { renderer: 'canvas' }); window.addEventListener('resize', function () { MC.resize(); }); }
      var names = rows.map(function (m) { return m.village; }).reverse();
      MC.setOption({
        backgroundColor: 'transparent', animationDuration: 800, animationEasing: 'cubicOut',
        grid: { left: 110, right: 70, top: 10, bottom: 30 },
        xAxis: { type: 'value', axisLabel: { color: '#6C7A96', fontFamily: 'JetBrains Mono, monospace', fontSize: 10 }, splitLine: { lineStyle: { color: 'rgba(234,217,174,0.06)' } }, axisLine: { show: false } },
        yAxis: { type: 'category', data: names, axisTick: { show: false }, axisLine: { show: false }, axisLabel: { color: '#D6DDE8', fontFamily: 'Cormorant Garamond, serif', fontSize: 16 } },
        tooltip: { trigger: 'item', backgroundColor: 'rgba(7,18,41,0.94)', borderColor: 'rgba(240,214,138,0.30)', textStyle: { color: '#fff', fontFamily: 'JetBrains Mono, monospace', fontSize: 12 },
          formatter: function (p) { var m = rows[rows.length - 1 - p.dataIndex]; return m.village + '<br/>' + (m.tier || '') + ' · ' + (m.composite_score > 0 ? '+' : '') + Number(m.composite_score).toFixed(1); } },
        series: [{ type: 'bar', barWidth: 14, showBackground: true, backgroundStyle: { color: 'rgba(255,255,255,0.03)', borderRadius: 4 },
          data: rows.slice().reverse().map(function (m) { var c = TIER_COLOR[tierOf(m)] || '#D9BE85'; return { value: Number(m.composite_score || 0),
            itemStyle: { borderRadius: [0, 4, 4, 0], color: new echarts.graphic.LinearGradient(0, 0, 1, 0, [{ offset: 0, color: c + '55' }, { offset: 1, color: c }]) } }; }),
          label: { show: true, position: 'right', color: '#EAD9AE', fontFamily: 'JetBrains Mono, monospace', fontSize: 11, formatter: function (p) { return (p.value > 0 ? '+' : '') + Number(p.value).toFixed(1); } },
          markLine: { silent: true, symbol: 'none', lineStyle: { color: 'rgba(234,217,174,0.25)', type: 'dashed' }, data: [{ xAxis: 0 }] } }]
      }, true);
    }
    supaRpc('get_smart_momentum', { scope_filter: 'all' }).then(function (rows) {
      MOM = rows || [];
      var tc = document.getElementById('tierChips'); tc.innerHTML = '';
      var tiers = ['ALL']; MOM.forEach(function (m) { var t = tierOf(m); if (t && tiers.indexOf(t) === -1) tiers.push(t); });
      tiers.forEach(function (t) {
        var b = document.createElement('button'); b.className = 'chip' + (t === TIER ? ' on' : ''); b.setAttribute('role', 'tab');
        b.textContent = t === 'ALL' ? 'All villages' : t.charAt(0) + t.slice(1).toLowerCase();
        b.addEventListener('click', function () { TIER = t; tc.querySelectorAll('.chip').forEach(function (c) { c.classList.toggle('on', c === b); }); renderMomentum(); });
        tc.appendChild(b);
      });
      if (!MOM.length) { document.getElementById('momGrid').innerHTML = '<p class="lede">Momentum signals are recalculating — see the map above for the live picture.</p>'; return; }
      renderMomentum();
    }).catch(function () {
      document.getElementById('momGrid').innerHTML = '<p class="lede">Momentum signals are recalculating — see the map above for the live picture.</p>';
    });

    /* ── briefing signup → leads (source: briefing) ── */
    var bf = document.getElementById('briefForm');
    bf.addEventListener('submit', function (e) {
      e.preventDefault();
      var em = document.getElementById('briefEmail');
      if (!bf.reportValidity()) return;
      var st = document.getElementById('briefStatus');
      st.textContent = 'Subscribing…';
      fetch(SUPA.URL + '/rest/v1/leads', {
        method: 'POST',
        headers: { apikey: SUPA.KEY, Authorization: 'Bearer ' + SUPA.KEY,
          'Content-Type': 'application/json', Prefer: 'return=minimal' },
        body: JSON.stringify({ source: 'briefing', email: em.value.trim(),
          message: 'Monthly briefing signup', page: location.pathname })
      }).then(function (r) {
        if (!r.ok) throw new Error(r.status);
        bf.reset(); st.textContent = 'Subscribed. First briefing arrives with the next monthly close.';
      }).catch(function () { st.textContent = 'Something went wrong — email pmilhaupt@jamesonsir.com and I’ll add you.'; });
    });

    refresh();
  });
  </script>
</Chapter>
