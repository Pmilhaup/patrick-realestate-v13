---
// HOMEPAGE — Lake Michigan at first light.
// One job per section: arrive on the North Shore, see the trophy sales, read the market,
// find a village, understand the approach, reach Patrick.
// The previous eight-movement homepage is preserved in git history (commit 9323813).
import Chapter from '../layouts/Chapter.astro';
import CoastMap from '../components/CoastMap.astro';
import Viz from '../components/Viz.astro';
import trophy from '../data/trophy.json';
import listings from '../data/listings.json';
import c from '../data/contact.json';

const money = (n) => '$' + Number(n).toLocaleString('en-US');
// Trophy sales: closed sales at or above the tier, highest first. Each links to its story where one exists.
const tier = trophy.tier;
const SIDE = { list: 'listing', buyer: 'buyer', both: 'both', referral: 'buyer' };
const withCtx = (l) => ({ ...l, ...(trophy.context[l.key] || {}), ytd: l.year === +trophy.context_as_of.slice(0, 4) });
const trophies = listings.sold.filter((l) => l.price >= tier && l.photo).sort((a, b) => b.price - a.price).map(withCtx);
const record = listings.sold.map(withCtx).map((l) => ({ address: l.address, town: l.town, year: l.year, price: l.price, side: SIDE[l.side] || 'listing', side_label: l.side_label, href: l.href || '', rank: l.rank, n: l.n, ytd: l.ytd }));
const pic = (l) => { const src = '/' + l.photo; const m = src.match(/^(.*)-(1400|1280)\.webp$/); return m ? { src: `${m[1]}-800.webp`, srcset: `${m[1]}-800.webp 800w, ${src} ${m[2]}w` } : { src }; };
const ld = {
  '@context': 'https://schema.org', '@type': 'RealEstateAgent', '@id': 'https://patrick.realestate/#agent',
  name: 'Patrick Milhaupt', url: 'https://patrick.realestate/',
  image: 'https://patrick.realestate/images/patrick-headshot.jpg',
  telephone: '+1-847-849-9828', email: c.email, jobTitle: 'Global Advisor',
  worksFor: { '@type': 'RealEstateAgent', name: "Jameson Sotheby's International Realty" },
  areaServed: ['Lake Forest, IL', 'Lake Bluff, IL', 'Highland Park, IL', 'Glencoe, IL', 'Winnetka, IL', 'Kenilworth, IL', 'Wilmette, IL']
    .map((name) => ({ '@type': 'Place', name })),
  knowsAbout: ['Luxury real estate', 'North Shore Chicago market', 'Market analytics', 'Pricing strategy'],
};
---
<Chapter
  title="Patrick Milhaupt — A North Shore Practice"
  description="Institutional discipline, applied to the North Shore's most significant homes. The market read daily; homes introduced carefully."
  path="/" current="/home" legacy={false} page="home" hero={true}
  ogImage="https://patrick.realestate/media/home/og.jpg"
  jsonLd={ld}
>
  <Fragment slot="head">
    <link rel="preload" as="image" type="image/avif" fetchpriority="high" media="(min-width: 900px)"
      imagesrcset="/media/home/first-light-1280.avif 1280w, /media/home/first-light-1920.avif 1920w, /media/home/first-light-2880.avif 2880w" imagesizes="100vw">
    <link rel="preload" as="image" type="image/avif" fetchpriority="high" media="(max-width: 899px)"
      imagesrcset="/media/home/first-light-portrait-640.avif 640w, /media/home/first-light-portrait-800.avif 800w, /media/home/first-light-portrait-1280.avif 1280w" imagesizes="100vw">
  </Fragment>

  <!-- ═══ Opening — the bluff at first light ═══ -->
  <section class="hero hero--home" data-hero="loop" data-film aria-labelledby="home-title">
    <div class="hero-media">
      <picture>
        <source media="(max-width: 899px)" type="image/avif" sizes="100vw"
          srcset="/media/home/first-light-portrait-640.avif 640w, /media/home/first-light-portrait-800.avif 800w, /media/home/first-light-portrait-1280.avif 1280w">
        <source media="(max-width: 899px)" type="image/webp" sizes="100vw"
          srcset="/media/home/first-light-portrait-640.webp 640w, /media/home/first-light-portrait-800.webp 800w, /media/home/first-light-portrait-1280.webp 1280w">
        <source type="image/avif" sizes="100vw"
          srcset="/media/home/first-light-1280.avif 1280w, /media/home/first-light-1920.avif 1920w, /media/home/first-light-2880.avif 2880w">
        <source type="image/webp" sizes="100vw"
          srcset="/media/home/first-light-1280.webp 1280w, /media/home/first-light-1920.webp 1920w, /media/home/first-light-2880.webp 2880w">
        <img src="/media/home/first-light-1920.jpg" width="1920" height="1080" fetchpriority="high" decoding="async"
          alt="Lake Michigan at first light, looking south along the Lake Forest shore: calm water, a beach with stone breakwaters, and the wooded bluff.">
      </picture>
      <video class="hero-film" muted playsinline loop preload="none" aria-hidden="true" tabindex="-1" disablepictureinpicture
        data-src-wide="/media/home/film-1080.mp4" data-src-tall="/media/home/film-portrait-720.mp4"></video>
    </div>
    <div class="hero-body">
      <p class="label">Patrick Milhaupt &middot; Jameson Sotheby&rsquo;s International Realty</p>
      <h1 class="display" id="home-title"><span class="line">The North Shore,</span> <span class="line"><em>measured</em> nightly.</span></h1>
      <p class="lede">A single-advisor practice built on the market read daily, direct sourcing of homes that are not for sale, and discretion as a working method.</p>
      <div class="actions">
        <a class="btn-gold" href="/properties">Explore properties</a>
        <a class="btn-line" href="/contact">Talk with Patrick</a>
        <a class="btn-line hero-value" href="/home-value">What is my home worth?</a>
      </div>
    </div>
    <div class="hero-tools">
      <p class="hero-caption">Lake Forest &middot; the shore at first light</p>
      <button class="motion-ctl" type="button" data-state="playing"><i aria-hidden="true"></i><span class="t">Pause motion</span></button>
    </div>
  </section>

  <!-- ═══ Trophy sales ═══ -->
  <section class="sec" aria-labelledby="trophy-title">
    <div class="wrap">
      <div class="sec-head sec-head--split rv">
        <div>
          <p class="label">Trophy sales</p>
          <h2 class="h2" id="trophy-title">The sales at the top of the market.</h2>
        </div>
        <p class="lede">{trophies.length} closings at {money(tier)} and above, on both sides of the table. Each is placed against every sale in its village that year.</p>
      </div>
    </div>
    <div class="rail rv" data-rail>
      <ul class="rail-track" tabindex="0" aria-label="Trophy sales, highest price first">
        {trophies.map((l, i) => {
          const Tag = l.href ? 'a' : 'div';
          return (
            <li class="rail-item">
              <Tag class="rail-card" href={l.href || undefined}>
                <span class="rail-photo"><img {...pic(l)} sizes="(max-width: 700px) 82vw, 420px" width="800" height="600" loading={i < 2 ? 'eager' : 'lazy'} fetchpriority="low" decoding="async"
                  style={l.href && l.href.startsWith('/sold/') ? `view-transition-name: sold-${l.href.slice(6)}` : undefined} alt={`${l.address}, ${l.town}`}></span>
                <span class="rail-meta"><span class="label">Closed {l.year} &middot; {l.town}</span><span class="rail-price">{money(l.price)}</span></span>
                <span class="rail-name">{l.address}</span>
                <span class="rail-note">{l.side_label}{l.rank ? ` · No. ${l.rank} of ${l.n} ${l.town} sales${l.ytd ? ' to date' : ''}` : ''}</span>
                {l.href && <span class="link-arrow" aria-hidden="true">Read the sale</span>}
              </Tag>
            </li>
          );
        })}
      </ul>
      <div class="rail-ctl wrap">
        <button type="button" class="rail-btn" data-rail-prev aria-label="Previous sales">&larr;</button>
        <button type="button" class="rail-btn" data-rail-next aria-label="More sales">&rarr;</button>
        <a class="link-arrow" href="/properties">Every property and sale</a>
      </div>
    </div>
    <div class="wrap" style="margin-top: clamp(36px, 6vh, 72px)">
      <Viz kind="record" tier={tier} data={record} height={400} label="Closed sales of one million dollars and above, by year and price" />
    </div>
  </section>

  <!-- ═══ The market — quiet surface, real data ═══ -->
  <section class="sec sec--surface" aria-labelledby="brief-title" data-brief>
    <div class="wrap">
      <div class="sec-head rv">
        <p class="label">The market brief</p>
        <h2 class="h2" id="brief-title">What sold on the North Shore this month?</h2>
      </div>
      <dl class="brief-grid rv">
        <div class="kpi-cell"><dt>Median sale &middot; 30 days</dt><dd><span class="n" data-b="med">&mdash;</span><span class="d" data-b="med-d">Median of the seven village medians</span></dd></div>
        <div class="kpi-cell"><dt>Closed sales &middot; 30 days</dt><dd><span class="n" data-b="closed">&mdash;</span><span class="d" data-b="closed-d">Across the seven villages</span></dd></div>
        <div class="kpi-cell"><dt>Days on market &middot; 30 days</dt><dd><span class="n" data-b="dom">&mdash;</span><span class="d">Median of the seven village medians</span></dd></div>
      </dl>
      <p class="brief-read rv" data-b="read" aria-live="polite"></p>
      <p class="asof rv" data-b="asof">Data as of &mdash;</p>
      <div class="sec-head rv" style="margin-top: clamp(40px, 7vh, 84px)">
        <p class="label">Eighteen years, and tonight</p>
        <h3 class="h3">Every month since 2008, with the live figure at the end.</h3>
      </div>
      <Viz kind="history" village="all" metric="price" span="all" height={480} label="North Shore market history since 2008" />
      <p class="op-foot rv"><a class="link-arrow" href="/intelligence">Read the full briefing</a></p>
    </div>
  </section>

  <!-- ═══ The villages ═══ -->
  <section class="sec" aria-labelledby="coast-title">
    <div class="wrap">
      <div class="sec-head rv">
        <p class="label">The village guide</p>
        <h2 class="h2" id="coast-title">Seven villages on eighteen miles of shoreline.</h2>
        <p class="lede">Choose a village to see where it sits on the lake and where its market stands today.</p>
      </div>
      <CoastMap start="Lake Forest" heading="h3" />
      <p class="op-foot rv"><a class="link-arrow" href="/neighborhoods">Every village guide</a></p>
    </div>
  </section>

  <!-- ═══ The approach ═══ -->
  <section class="sec sec--surface" aria-labelledby="approach-title">
    <div class="wrap">
      <div class="approach">
        <figure class="approach-portrait rv">
          <img src="/media/brand/patrick-portrait-600.webp" srcset="/media/brand/patrick-portrait-600.webp 600w, /media/brand/patrick-portrait-928.webp 928w"
            sizes="(max-width: 899px) 240px, 320px" width="928" height="1201" loading="lazy" decoding="async"
            alt="Patrick Milhaupt, Global Advisor, Jameson Sotheby's International Realty">
          <figcaption class="label label--quiet">Patrick Milhaupt</figcaption>
        </figure>
        <div>
          <div class="sec-head rv">
            <p class="label">My approach</p>
            <h2 class="h2" id="approach-title">Six steps. Each has a checklist. None gets skipped.</h2>
            <p class="lede">I spent nine years underwriting more than $500 million in institutional real estate before I joined Sotheby&rsquo;s International Realty in 2016. I price and present a house the way I underwrote a portfolio: from the evidence, in order.</p>
          </div>
          <ol class="asteps rv">
            <li>Provenance research</li>
            <li>Reconciled pricing</li>
            <li>Photography and narrative</li>
            <li>Pre-market window</li>
            <li>Global syndication</li>
            <li>Negotiation and close audit</li>
          </ol>
          <div class="actions rv">
            <a class="link-arrow" href="/selling">How a home is represented</a>
            <a class="link-arrow" href="/about">About Patrick</a>
          </div>
        </div>
      </div>
      <ul class="record rv" style="margin-top: clamp(48px, 8vh, 96px);" aria-label="On the record">
        <li>
          <blockquote>&ldquo;Former Motorola exec lists Lake Forest mansion for almost $13 million&rdquo;</blockquote>
          <cite>Crain&rsquo;s Chicago Business &middot; March 2024</cite>
        </li>
        <li>
          <blockquote>&ldquo;We&rsquo;ve got a lot of Bears players, several of which are my clients.&rdquo;</blockquote>
          <cite>Patrick Milhaupt, quoted in The Real Deal &middot; September 2024</cite>
        </li>
        <li>
          <blockquote>$13.1M closed volume. $2.02M average price.</blockquote>
          <cite>2024 &middot; RealTrends Verified Top Agent</cite>
        </li>
      </ul>
    </div>
  </section>

  <!-- ═══ The invitation ═══ -->
  <section class="sec" aria-labelledby="invite-title">
    <div class="wrap invite">
      <p class="label rv">Begin</p>
      <h2 class="h2 rv" id="invite-title">Thirty minutes. No pitch.</h2>
      <p class="lede rv">A direct conversation about what you&rsquo;re trying to do, and an honest read on whether I&rsquo;m the right advisor for it.</p>
      <div class="actions rv">
        <a class="btn-gold" href="/contact">Send a message</a>
        <a class="btn-line" href={`tel:${c.tel}`}>{c.phone}</a>
        <a class="btn-line" href={`mailto:${c.email}`}>Email Patrick</a>
      </div>
    </div>
  </section>
</Chapter>
