---
// The North Shore coastline, Wilmette to Lake Bluff, drawn from shoreline coordinates
// (equirectangular projection at 42.18° N). Schematic: villages are marked at their lakefronts.
// Selecting a village — on the map or in the list — changes its photograph and market read.
const { start = 'Lake Forest', heading = 'h3' } = Astro.props;
const pins = [{"name": "Lake Bluff", "x": 123.2, "y": 70.0}, {"name": "Lake Forest", "x": 143.1, "y": 155.0}, {"name": "Highland Park", "x": 219.3, "y": 357.6}, {"name": "Glencoe", "x": 301.0, "y": 499.2}, {"name": "Winnetka", "x": 360.2, "y": 584.2}, {"name": "Kenilworth", "x": 403.1, "y": 642.3}, {"name": "Wilmette", "x": 444.6, "y": 680.1}];
const info = {
  'Lake Bluff':    { tag: 'Guide in progress', note: 'The northern end of the corridor, on the bluff above the lake. Its market data is live below; the written guide is in progress.', href: '' },
  'Lake Forest':   { tag: 'Estate scale', note: 'The corridor’s anchor: estate-scale lots, houses by Howard Van Doren Shaw and David Adler, and six distinct sub-markets inside one village.', href: '/neighborhoods/lake-forest',
                     photo: '/media/999/bluff-1000.webp', alt: 'The Lake Michigan bluff at Lake Road in Lake Forest at first light', caption: 'The bluff at Lake Road, Lake Forest' },
  'Highland Park': { tag: 'Beachfront', note: 'The most architecturally varied village on the corridor, with the widest price range north of Chicago.', href: '/neighborhoods/highland-park' },
  'Glencoe':       { tag: 'Ravine and lakefront', note: 'Lakefront ravines and the Chicago Botanic Garden at its western edge.', href: '/neighborhoods/glencoe' },
  'Winnetka':      { tag: 'Walk to the lake', note: 'Walkable and lakefront, with the tightest inventory on the corridor.', href: '/neighborhoods/winnetka' },
  'Kenilworth':    { tag: 'Smallest, rarest', note: 'The smallest village by parcel count, with houses by Howard Van Doren Shaw and George Washington Maher.', href: '/neighborhoods/kenilworth' },
  'Wilmette':      { tag: 'Village energy', note: 'The southern gateway to the corridor and consistently its fastest-moving market.', href: '/neighborhoods/wilmette',
                     photo: '/media/listings/925-ashland-800.webp', alt: 'A brick house on Ashland Avenue in Wilmette', caption: '925 Ashland Avenue, Wilmette. Sold 2026.' },
};
const H = heading;
---
<div class="coast" data-coast={start}>
  <script type="application/json" set:html={JSON.stringify(info)} />
  <div class="coast-map rv">
    <svg viewBox="0 0 480 760" role="group" aria-label="Map of the North Shore coastline from Wilmette to Lake Bluff. Select a village.">
      <path class="land" d="M 462.3 760.0 C 461.6 755.0 459.5 740.4 457.8 730.2 C 456.1 720.0 454.2 706.9 452.3 698.9 C 450.4 690.9 451.4 688.7 446.4 682.5 C 441.4 676.3 430.0 668.6 422.5 661.6 C 415.0 654.6 408.9 649.2 401.5 640.8 C 394.1 632.4 385.5 620.9 378.3 611.0 C 371.1 601.1 364.8 591.1 358.5 581.2 C 352.2 571.3 349.7 563.8 340.8 551.4 C 331.9 539.0 315.7 521.6 305.4 506.7 C 295.1 491.8 287.7 476.9 278.9 462.0 C 270.1 447.1 262.3 434.7 252.4 417.3 C 242.5 399.9 229.6 377.5 219.3 357.6 C 209.0 337.7 198.7 315.4 190.6 298.0 C 182.5 280.6 176.9 270.7 170.7 253.3 C 164.4 235.9 157.7 210.1 153.1 193.7 C 148.5 177.3 146.8 169.9 143.1 155.0 C 139.4 140.1 134.5 119.2 131.0 104.3 C 127.5 89.4 124.9 83.0 122.1 65.6 C 119.3 48.2 115.7 10.9 114.4 0.0 L 0.0 0.0 L 0.0 760.0 Z" />
      {[0.25, 0.5, 0.75].map((t) => <line class="water-line" x1={170 + t * 300} x2={170 + t * 300} y1="0" y2="760" />)}
      <path class="shore" d="M 462.3 760.0 C 461.6 755.0 459.5 740.4 457.8 730.2 C 456.1 720.0 454.2 706.9 452.3 698.9 C 450.4 690.9 451.4 688.7 446.4 682.5 C 441.4 676.3 430.0 668.6 422.5 661.6 C 415.0 654.6 408.9 649.2 401.5 640.8 C 394.1 632.4 385.5 620.9 378.3 611.0 C 371.1 601.1 364.8 591.1 358.5 581.2 C 352.2 571.3 349.7 563.8 340.8 551.4 C 331.9 539.0 315.7 521.6 305.4 506.7 C 295.1 491.8 287.7 476.9 278.9 462.0 C 270.1 447.1 262.3 434.7 252.4 417.3 C 242.5 399.9 229.6 377.5 219.3 357.6 C 209.0 337.7 198.7 315.4 190.6 298.0 C 182.5 280.6 176.9 270.7 170.7 253.3 C 164.4 235.9 157.7 210.1 153.1 193.7 C 148.5 177.3 146.8 169.9 143.1 155.0 C 139.4 140.1 134.5 119.2 131.0 104.3 C 127.5 89.4 124.9 83.0 122.1 65.6 C 119.3 48.2 115.7 10.9 114.4 0.0" />
      <text class="map-note" x="462" y="392" text-anchor="end">Lake Michigan</text>
      <text class="map-note" x="18" y="34">N ↑</text>
      <line class="shore" x1="18" x2="233.7" y1="734" y2="734" opacity=".55" />
      <text class="map-note" x="18" y="724">5 miles</text>
      <text class="map-note" x="18" y="54">Schematic</text>
      {pins.map((p) => (
        <g class="pin" role="button" tabindex="0" data-v={p.name} aria-pressed={p.name === start ? 'true' : 'false'} aria-label={p.name}>
          <circle class="hit" cx={p.x} cy={p.y} r="24" />
          <circle class="mark" cx={p.x} cy={p.y} r="6" />
          <text x={p.x - 16} y={p.y + 5} text-anchor="end">{p.name}</text>
        </g>
      ))}
    </svg>
  </div>
  <div class="coast-panel">
    <article class="coast-card rv" data-c="card" aria-live="polite">
      <figure class="coast-photo" data-c="photo" hidden><img src="" alt="" width="1000" height="563" loading="lazy" decoding="async"><figcaption class="vh"></figcaption></figure>
      <H class="h3" data-c="name">{start}</H>
      <p class="coast-stat" data-c="stat"></p>
      <p class="note" data-c="note">{info[start].note}</p>
      <a class="link-arrow" data-c="link" href={info[start].href || '#'} hidden={!info[start].href}>Open the {start} guide</a>
    </article>
    <ul class="coast-list rv" aria-label="Villages, north to south">
      {pins.map((p) => (
        <li><button type="button" data-v={p.name} aria-pressed={p.name === start ? 'true' : 'false'}><span class="vn">{p.name}</span><span class="vd">{info[p.name].tag}</span></button></li>
      ))}
    </ul>
  </div>
</div>
