---
// One interactive visualization. The chart engine (Apache ECharts) is loaded only when the figure nears the viewport.
// kind: history | motion | seasons | record | budget | eras
const { kind, village, metric, span, lock = false, height = 460, tier, budget, data, label = 'Interactive chart' } = Astro.props;
---
<figure class={`viz viz--${kind} rv`} data-viz={kind} data-village={village} data-metric={metric} data-span={span} data-tier={tier} data-budget={budget} data-lock-village={lock ? '' : undefined}>
  {data && <script type="application/json" set:html={JSON.stringify(data)} />}
  <div class="viz-bar"></div>
  <div class="viz-plot" role="img" aria-label={label} style={`--viz-h:${height}px`}><span class="viz-wait label label--quiet">Loading the figures</span></div>
  <figcaption class="note viz-cap"><slot /></figcaption>
</figure>

<script>
  const figures = document.querySelectorAll('[data-viz]');
  if (figures.length) {
    // The chart engine is large. It never loads before the page's own images have finished, so it cannot slow the first view.
    const load = () => import('../scripts/viz.js').then((m) => m.mount(figures));
    const start = () => (document.readyState === 'complete' ? load() : addEventListener('load', load, { once: true }));
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => { if (entries.some((e) => e.isIntersecting)) { io.disconnect(); start(); } }, { rootMargin: '700px 0px' });
      figures.forEach((f) => io.observe(f));
    } else start();
  }
</script>
